{
  "name": "umpires-eye",
  "version": "0.0.0",
  "private": true,
  "description": "Call real MLB pitches from the plate umpire's eye.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "npm run check:lockfile && eslint .",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "typecheck": "tsc --noEmit && tsc -p src/core/tsconfig.json && npm run data:typecheck",
    "test": "vitest run && npm run data:test",
    "e2e": "node scripts/e2e.ts",
    "assets": "node scripts/build-assets.mjs",
    "data:fetch": "node tools/data/fetch.ts",
    "data:build": "node tools/data/build.ts",
    "data:daily": "node tools/data/daily.ts",
    "data:validate": "node tools/data/validate.ts",
    "data:test": "node --test \"tools/data/test/*.test.ts\"",
    "data:typecheck": "tsc -p tools/data/tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.55.0",
    "@stylistic/eslint-plugin": "^5.2.3",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.34.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
